# Mailchimp Marketing API key. The data-center suffix (e.g. -us1) is part of the key
# itself — copy it exactly as shown on the API keys page, it is not a separate setting.
MAILCHIMP_API_KEY=your-mailchimp-api-key-here-us1

# The audience (list) this campaign's recipients come from. Optional: if unset, push.py
# calls GET /lists and uses the audience automatically when your account has exactly one;
# otherwise it prints the list of audience ids and asks you to set this variable.
MAILCHIMP_AUDIENCE_ID=

# Required — Mailchimp rejects a campaign without a from-name and reply-to address.
MAILCHIMP_FROM_NAME=Your Newsletter Name
MAILCHIMP_REPLY_TO=you@example.com

# Only needed to run collect.py (Stage 1) against a Google Sheet. push.py (Stage 2) needs
# nothing Google. Create a free API key in Google Cloud console with the Sheets API
# enabled — see sheet-layout.md.
GOOGLE_SHEETS_API_KEY=
